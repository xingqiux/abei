FIREFLY_IMAGE=docker.xkqq.top/firefly/firefly-ai-accounting:latest
GRANARY_WEB_IMAGE=docker.xkqq.top/firefly/granary-web:latest
FIREFLY_PORT=18001
GRANARY_WEB_PORT=18002

APP_ENV=production
APP_DEBUG=false
APP_URL=https://firefly.xkqq.top
APP_KEY=base64:replace-with-current-local-app-key
TZ=Asia/Shanghai
TRUSTED_PROXIES=**

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=replace-with-long-random-password
PGSQL_SCHEMA=public
PGSQL_SSL_MODE=prefer

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

POSTGRES_DB=firefly
POSTGRES_USER=firefly
POSTGRES_PASSWORD=replace-with-long-random-password
