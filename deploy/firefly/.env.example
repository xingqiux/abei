FIREFLY_IMAGE=docker.xkqq.top/firefly/firefly-ai-accounting:latest
ABEI_API_IMAGE=docker.xkqq.top/firefly/abei-api:latest
ABEI_WEB_IMAGE=docker.xkqq.top/firefly/abei-web:latest
ABEI_AGENT_IMAGE=docker.xkqq.top/firefly/abei-agent:latest
FIREFLY_PORT=18001
ABEI_AGENT_PORT=18003
ABEI_WEB_PORT=18004

AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_DB_POOL_SIZE=5
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
OLLAMA_BASE_URL=

APP_ENV=production
APP_DEBUG=false
APP_URL=https://firefly.xkqq.top
APP_KEY=base64:replace-with-current-local-app-key
ABEI_MAIL_SYNC_INTERVAL=300
ABEI_MAIL_TIMEOUT_SECONDS=60
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://finance.example.com/oauth/google/callback
# 两项都留空时反馈只存本地库；启用 GitHub 同步时必须一起填写。
ABEI_GITHUB_REPO=
ABEI_GITHUB_TOKEN=
TZ=Asia/Shanghai
TRUSTED_PROXIES=**

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=replace-with-long-random-password
PGSQL_SCHEMA=public
PGSQL_SSL_MODE=prefer

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

POSTGRES_DB=firefly
POSTGRES_USER=firefly
POSTGRES_PASSWORD=replace-with-long-random-password
