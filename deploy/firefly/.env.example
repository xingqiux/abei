FIREFLY_IMAGE=docker.xkqq.top/firefly/firefly-ai-accounting:latest
ABAKU_WEB_IMAGE=docker.xkqq.top/firefly/abaku-web:latest
ABAKU_AGENT_IMAGE=docker.xkqq.top/firefly/abaku-agent:latest
FIREFLY_PORT=18001
ABAKU_WEB_PORT=18002
ABAKU_AGENT_PORT=18003

AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_DB_POOL_SIZE=5
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
OLLAMA_BASE_URL=

APP_ENV=production
APP_DEBUG=false
APP_URL=https://firefly.xkqq.top
APP_KEY=base64:replace-with-current-local-app-key
TZ=Asia/Shanghai
TRUSTED_PROXIES=**

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=replace-with-long-random-password
PGSQL_SCHEMA=public
PGSQL_SSL_MODE=prefer

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

POSTGRES_DB=firefly
POSTGRES_USER=firefly
POSTGRES_PASSWORD=replace-with-long-random-password
