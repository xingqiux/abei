COMPOSE_PROJECT_NAME=firefly-ai-accounting-dev

FIREFLY_PORT=18001
ABEI_API_PORT=18002
ABEI_AGENT_PORT=18003
ABEI_WEB_PORT=18004
# abei-api 在 /health 里公布这个地址，供未配对的 CLI 打开网页。
ABEI_WEB_URL=http://127.0.0.1:18004
ABEI_SERVER_URL=http://127.0.0.1:18005
# abei-api 与 abei-server 之间的共享密钥。abei-server 只接受由它签名的身份，
# 两个服务必须配同一个值；至少 32 个字符，两边缺一个都起不来。
# 换一个新值不会影响已存的数据，但两边要同时换。
ABEI_INTERNAL_SECRET=change-me-to-a-random-32-char-secret
# 带数据库的 Rust 用例认这个变量，不给就整批静默跳过。`make test-rust` 会自己按
# POSTGRES_* 拼出本地 db 容器的地址，这里只在你想指到别的库时才需要写。
# ABEI_TEST_DATABASE_URL=postgres://firefly:firefly-local-only@127.0.0.1:15432/firefly
ABEI_MAIL_STORAGE=../firefly-iii/storage/app
ABEI_MAIL_SYNC_INTERVAL=300
ABEI_MAIL_TIMEOUT_SECONDS=60
# Google Cloud 的「Web application」OAuth 客户端。两项留空时 Gmail OAuth2 不启用。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://127.0.0.1:18004/oauth/google/callback
POSTGRES_PORT=15432
MAIL_SMTP_PORT=13025
MAIL_IMAP_PORT=13143

APP_ENV=local
APP_DEBUG=true
# APP_URL defaults to http://localhost:${FIREFLY_PORT}
# Keep this value stable: changing it makes stored mailbox passwords unreadable.
APP_KEY=SomeRandomStringOf32CharsExactly
TZ=Asia/Shanghai
TRUSTED_PROXIES=**

# AI_PROVIDER: openai / anthropic / google / cloudflare-ai-gateway /
# cloudflare-workers-ai / ollama。切 provider 时同时填写对应 AI_MODEL。
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_DB_POOL_SIZE=5
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

POSTGRES_DB=firefly
POSTGRES_USER=firefly
POSTGRES_PASSWORD=firefly-local-only

TEST_POSTGRES_DB=firefly_test
TEST_POSTGRES_USER=firefly_test
TEST_POSTGRES_PASSWORD=firefly-test-only

MAIL_USERNAME=bills
MAIL_PASSWORD=bills-local-only
