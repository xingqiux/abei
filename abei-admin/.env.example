# abei-admin 的构建期变量。复制成 .env.local 再改，.env.local 不进版本库。

# abei-api 的地址。留空走同源（生产由 nginx 反代 /v1 过去）。
# 开发期不用配：vite.config.ts 里已经把 /v1 代理到 127.0.0.1:18002。
VITE_ABEI_API_URL=

# 前台（abei-web）的地址，顶栏「去前台」用它。
# 不配的话：开发环境回退到 http://localhost:5173，生产环境隐藏这个链接并在控制台留一句警告。
VITE_ABEI_WEB_URL=

# 开发期免去每次粘贴令牌。只在本机用，别写进 .env.example 以外的任何提交里。
VITE_FIREFLY_TOKEN=
