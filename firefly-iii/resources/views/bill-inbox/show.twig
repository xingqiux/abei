{% extends './layout/default' %}

{% block breadcrumbs %}
    {{ Breadcrumbs.render(Route.getCurrentRoute.getName, task) }}
{% endblock %}

{% block content %}
    <style>
        .bill-autocomplete { position: relative; }
        .bill-autocomplete-menu {
            display: none;
            position: absolute;
            z-index: 1000;
            left: 0;
            right: 0;
            margin: 0;
            padding: 0;
            max-height: 220px;
            overflow-y: auto;
            list-style: none;
            background: #fff;
            border: 1px solid #ccc;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
        }
        .bill-autocomplete-menu li {
            padding: 4px 8px;
            cursor: pointer;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .bill-autocomplete-menu li.active,
        .bill-autocomplete-menu li:hover {
            background: #f5f5f5;
        }
        .bill-row-readonly dt {
            width: 90px;
        }
        .bill-row-readonly dd {
            margin-left: 100px;
            margin-bottom: 4px;
        }
        #bill-row-ajax-alert {
            display: none;
            margin: 10px 15px 0;
        }
    </style>
    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="box">
                <div class="box-header with-border">
                    <h3 class="box-title">账单任务 #{{ task.id }}</h3>
                    <div class="box-tools pull-right">
                        <a class="btn btn-box-tool" href="{{ route('bill-inbox.index') }}">
                            <span class="fa fa-list fa-fw"></span> 返回列表
                        </a>
                    </div>
                </div>
                <div class="box-body no-padding">
                    <table class="table table-striped">
                        <tr>
                            <td style="width: 160px;">状态</td>
                            <td><span class="label {{ statusClasses[task.status]|default('label-info') }}">{{ statusLabels[task.status]|default(task.status) }}</span></td>
                        </tr>
                        <tr>
                            <td>来源</td>
                            <td>{{ task.source }}{% if task.profile_id %} / {{ task.profile_id }}{% endif %}</td>
                        </tr>
                        <tr>
                            <td>摘要</td>
                            <td>{{ task.summary|default('-') }}</td>
                        </tr>
                        <tr>
                            <td>收到时间</td>
                            <td>{% if task.received_at %}{{ task.received_at.format('Y-m-d H:i:s') }}{% else %}-{% endif %}</td>
                        </tr>
                        {% if task.error_message %}
                            <tr>
                                <td>错误</td>
                                <td>{{ task.error_message }}</td>
                            </tr>
                        {% endif %}
                    </table>
                </div>
                <div class="box-footer">
                    <form method="POST" action="{{ route('bill-inbox.archive', [task.id]) }}" style="display: inline-block;">
                        <input type="hidden" name="_token" value="{{ csrf_token() }}">
                        <button type="submit" class="btn btn-default">
                            <span class="fa fa-archive fa-fw"></span> 归档
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {% if task.currentSecretChallenge %}
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="box box-warning">
                    <div class="box-header with-border">
                        <h3 class="box-title">需要密码或验证码</h3>
                    </div>
                    <form method="POST" action="{{ route('bill-inbox.secret', [task.id]) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token() }}">
                        <div class="box-body">
                            <p>{{ task.currentSecretChallenge.prompt|default('请输入账单解密密码或验证码') }}</p>
                            <div class="form-group">
                                <label for="bill-secret-value">密码/验证码</label>
                                <input id="bill-secret-value" class="form-control" type="password" name="value" autocomplete="one-time-code" required>
                            </div>
                        </div>
                        <div class="box-footer">
                            <button type="submit" class="btn btn-success">
                                <span class="fa fa-key fa-fw"></span> 提交并继续处理
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="box">
                <div class="box-header with-border">
                    <h3 class="box-title">流水明细</h3>
                </div>
                <div class="box-body">
                    <form method="GET" action="{{ route('bill-inbox.show', [task.id]) }}" class="form-inline">
                        <div class="form-group">
                            <label for="bill-row-status">状态</label>
                            <select id="bill-row-status" class="form-control input-sm" name="row_status">
                                <option value="">全部</option>
                                <option value="pending" {% if rowFilters.status == 'pending' %}selected{% endif %}>待存入</option>
                                <option value="imported" {% if rowFilters.status == 'imported' %}selected{% endif %}>已存入</option>
                                <option value="failed" {% if rowFilters.status == 'failed' %}selected{% endif %}>处理失败</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="bill-row-time">时间</label>
                            <select id="bill-row-time" class="form-control input-sm" name="row_time">
                                <option value="all" {% if rowFilters.time == 'all' %}selected{% endif %}>全部</option>
                                <option value="day" {% if rowFilters.time == 'day' %}selected{% endif %}>每日</option>
                                <option value="custom" {% if rowFilters.time == 'custom' %}selected{% endif %}>自定义</option>
                            </select>
                        </div>
                        {% if rowFilters.time == 'day' %}
                            <a class="btn btn-default btn-sm" href="{{ route('bill-inbox.show', {billTask: task.id, row_status: rowFilters.status, row_time: 'day', row_date: rowFilters.prevDate}) }}">上一天</a>
                        {% endif %}
                        <div class="form-group">
                            <input id="bill-row-date" class="form-control input-sm" type="date" name="row_date" value="{{ rowFilters.date }}">
                        </div>
                        {% if rowFilters.time == 'day' %}
                            <a class="btn btn-default btn-sm" href="{{ route('bill-inbox.show', {billTask: task.id, row_status: rowFilters.status, row_time: 'day', row_date: rowFilters.nextDate}) }}">下一天</a>
                        {% endif %}
                        {% if rowFilters.time == 'custom' %}
                            <div class="form-group">
                                <input class="form-control input-sm" type="date" name="row_from" value="{{ rowFilters.from }}">
                            </div>
                            <div class="form-group">
                                <input class="form-control input-sm" type="date" name="row_to" value="{{ rowFilters.to }}">
                            </div>
                        {% endif %}
                        <button type="submit" class="btn btn-default btn-sm">
                            <span class="fa fa-filter fa-fw"></span> 筛选
                        </button>
                    </form>
                </div>
                <div class="box-body no-padding">
                    {% if statementRows.count() == 0 %}
                        <p class="text-muted" style="padding: 15px;">暂无流水明细。</p>
                    {% else %}
                        <form id="bill-row-batch-import" method="POST" action="{{ route('bill-inbox.import', [task.id]) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="row_status" value="{{ rowFilters.status }}">
                            <input type="hidden" name="row_time" value="{{ rowFilters.time }}">
                            <input type="hidden" name="row_date" value="{{ rowFilters.date }}">
                            <input type="hidden" name="row_from" value="{{ rowFilters.from }}">
                            <input type="hidden" name="row_to" value="{{ rowFilters.to }}">
                        </form>
                        <div id="bill-row-ajax-alert" class="alert" role="alert"></div>
                        <div style="padding: 10px 15px; border-bottom: 1px solid #f4f4f4;">
                            <div class="row">
                                <div class="col-sm-8">
                                    <p class="text-muted" style="margin: 0;">勾选下方待存入的流水，再点击右侧按钮批量存入 Firefly III。</p>
                                </div>
                                <div class="col-sm-4 text-right">
                                    <button id="bill-row-batch-import-submit" type="submit" form="bill-row-batch-import" class="btn btn-success btn-sm" disabled>
                                        <span class="fa fa-upload fa-fw"></span> 存入选中 (<span id="bill-row-batch-import-count">0</span>)
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead>
                                <tr>
                                    <th style="width: 36px;"><input id="bill-row-select-all" type="checkbox" title="全选/取消全选本页可存入流水"></th>
                                    <th>时间</th>
                                    <th>原始流水</th>
                                    <th>Firefly 草稿</th>
                                    <th>状态</th>
                                    <th style="width: 150px;">操作</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for row in statementRows %}
                                    <tr data-row-id="{{ row.id }}" data-role="summary">
                                        <td>
                                            {% if row.status == 'pending' and row.firefly_type %}
                                                <input form="bill-row-batch-import" class="bill-row-checkbox" type="checkbox" name="row_ids[]" value="{{ row.id }}">
                                            {% endif %}
                                        </td>
                                        <td>{% if row.occurred_at %}{{ row.occurred_at.format('Y-m-d H:i') }}{% else %}-{% endif %}</td>
                                        <td>
                                            <div><strong>{{ row.counterparty|default('-') }}</strong></div>
                                            <div>分类：{{ row.platform_category|default('-') }}</div>
                                            <div>说明：{{ row.description|default('-') }}</div>
                                            <div>收/支：{{ row.direction|default('-') }} / 金额：{{ row.amount|default('-') }}</div>
                                            <div class="text-muted">付款方式：{{ row.payment_method|default('-') }}</div>
                                            {% if row.metadata.payment_split is defined %}
                                                <div class="text-warning">组合支付：{{ row.metadata.payment_split.reason|default('需要拆分实际扣款账户和金额') }}</div>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div><strong data-field-display="firefly_description">{{ row.firefly_description|default('-') }}</strong></div>
                                            <div data-field-display="source_name_line">来源：{{ row.source_name|default('-') }}</div>
                                            <div data-field-display="destination_name_line">目标：{{ row.destination_name|default('-') }}</div>
                                            <div data-field-display="category_name_line">分类：{{ row.category_name|default('-') }}</div>
                                            <div data-field-display="firefly_description_line">描述：{{ row.firefly_description|default('-') }}</div>
                                            <div><span data-field-display="firefly_type_line">类型：{{ fireflyTypeLabels[row.firefly_type]|default('-') }}</span> <span data-field-display="firefly_amount_line">/ 金额：{{ row.firefly_amount|default('-') }}</span></div>
                                        </td>
                                        <td>
                                            <span class="label {{ statusClasses[row.status]|default('label-info') }}" data-field-display="status-badge">{{ statusLabels[row.status]|default(row.status) }}</span>
                                            <span class="label label-warning" data-field-display="duplicate-badge" {% if row.duplicate_state != 'duplicate' %}style="display: none;"{% endif %}>重复</span>
                                            <span class="label gc-status-attention" data-field-display="conflict-badge" {% if row.duplicate_state != 'conflict' %}style="display: none;"{% endif %}>冲突</span>
                                        </td>
                                        <td>
                                            <a class="btn btn-xs btn-default" data-toggle="collapse" href="#bill-row-{{ row.id }}">
                                                <span class="fa fa-pencil fa-fw"></span> 编辑
                                            </a>
                                            {% if row.status == 'pending' and row.firefly_type %}
                                                <form method="POST" action="{{ route('bill-inbox.import', [task.id]) }}" class="bill-row-import-form" data-row-id="{{ row.id }}" style="display: inline-block;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token() }}">
                                                    <input type="hidden" name="row_ids[]" value="{{ row.id }}">
                                                    <input type="hidden" name="row_status" value="{{ rowFilters.status }}">
                                                    <input type="hidden" name="row_time" value="{{ rowFilters.time }}">
                                                    <input type="hidden" name="row_date" value="{{ rowFilters.date }}">
                                                    <input type="hidden" name="row_from" value="{{ rowFilters.from }}">
                                                    <input type="hidden" name="row_to" value="{{ rowFilters.to }}">
                                                    <button class="btn btn-xs btn-success" type="submit">
                                                        <span class="fa fa-upload fa-fw"></span> 存入
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    <tr id="bill-row-{{ row.id }}" class="collapse" data-row-id="{{ row.id }}">
                                        <td colspan="6">
                                            {% if row.status == 'needs_split' %}
                                                <form method="POST" action="{{ route('bill-inbox.row.split', [row.id]) }}" class="form-horizontal" style="margin-bottom: 20px;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token() }}">
                                                    <input type="hidden" name="row_status" value="{{ rowFilters.status }}">
                                                    <input type="hidden" name="row_time" value="{{ rowFilters.time }}">
                                                    <input type="hidden" name="row_date" value="{{ rowFilters.date }}">
                                                    <input type="hidden" name="row_from" value="{{ rowFilters.from }}">
                                                    <input type="hidden" name="row_to" value="{{ rowFilters.to }}">
                                                    <div class="row">
                                                        {% set splitMethods = row.metadata.payment_split.methods|default([]) %}
                                                        {% for index, method in splitMethods %}
                                                            <div class="col-sm-4">
                                                                <label>支付方式</label>
                                                                <input class="form-control" name="splits[{{ index }}][payment_method]" value="{{ method }}">
                                                            </div>
                                                            <div class="col-sm-4">
                                                                <label>来源账户</label>
                                                                <input class="form-control" name="splits[{{ index }}][source_name]" value="{{ method }}">
                                                            </div>
                                                            <div class="col-sm-4">
                                                                <label>实际金额</label>
                                                                <input class="form-control" name="splits[{{ index }}][amount]" placeholder="0.00">
                                                            </div>
                                                        {% endfor %}
                                                    </div>
                                                    <div style="margin-top: 10px;">
                                                        <button type="submit" class="btn btn-warning btn-sm">
                                                            <span class="fa fa-code-fork fa-fw"></span> 保存拆分
                                                        </button>
                                                    </div>
                                                </form>
                                            {% endif %}
                                            <div class="row">
                                                <div class="col-sm-5">
                                                    <h5 style="margin-top: 0;">原始流水（只读）</h5>
                                                    <dl class="dl-horizontal bill-row-readonly" style="margin-bottom: 0;">
                                                        <dt>交易时间</dt>
                                                        <dd>{% if row.occurred_at %}{{ row.occurred_at.format('Y-m-d H:i:s') }}{% else %}-{% endif %}</dd>
                                                        <dt>分类</dt>
                                                        <dd>{{ row.platform_category|default('-') }}</dd>
                                                        <dt>交易对方</dt>
                                                        <dd>{{ row.counterparty|default('-') }}</dd>
                                                        <dt>说明</dt>
                                                        <dd>{{ row.description|default('-') }}</dd>
                                                        <dt>收/支</dt>
                                                        <dd>{{ row.direction|default('-') }}</dd>
                                                        <dt>金额</dt>
                                                        <dd>{{ row.amount|default('-') }}</dd>
                                                        <dt>付款方式</dt>
                                                        <dd>{{ row.payment_method|default('-') }}</dd>
                                                        <dt>交易状态</dt>
                                                        <dd>{{ row.transaction_status|default('-') }}</dd>
                                                    </dl>
                                                </div>
                                                <div class="col-sm-7">
                                                    <h5 style="margin-top: 0;">Firefly 草稿</h5>
                                                    <form method="POST" action="{{ route('bill-inbox.row.update', [row.id]) }}" class="form-horizontal bill-row-update-form" data-row-id="{{ row.id }}">
                                                        <input type="hidden" name="_token" value="{{ csrf_token() }}">
                                                        <input type="hidden" name="row_status" value="{{ rowFilters.status }}">
                                                        <input type="hidden" name="row_time" value="{{ rowFilters.time }}">
                                                        <input type="hidden" name="row_date" value="{{ rowFilters.date }}">
                                                        <input type="hidden" name="row_from" value="{{ rowFilters.from }}">
                                                        <input type="hidden" name="row_to" value="{{ rowFilters.to }}">
                                                        <div class="row">
                                                            <div class="col-sm-4 form-group">
                                                                <label>Firefly 类型</label>
                                                                <select class="form-control" name="firefly_type" data-field="firefly_type">
                                                                    <option value="">不导入</option>
                                                                    {% for type, label in fireflyTypeLabels %}
                                                                        <option value="{{ type }}" {% if row.firefly_type == type %}selected{% endif %}>{{ label }}</option>
                                                                    {% endfor %}
                                                                </select>
                                                                <div class="text-danger small" data-error-for="firefly_type"></div>
                                                            </div>
                                                            <div class="col-sm-4 form-group">
                                                                <label>Firefly 时间</label>
                                                                <input class="form-control" type="datetime-local" name="firefly_date" data-field="firefly_date" value="{% if row.firefly_date %}{{ row.firefly_date.format('Y-m-d\\TH:i') }}{% endif %}">
                                                                <div class="text-danger small" data-error-for="firefly_date"></div>
                                                            </div>
                                                            <div class="col-sm-4 form-group">
                                                                <label>Firefly 金额</label>
                                                                <input class="form-control" type="number" step="0.01" min="0" name="firefly_amount" data-field="firefly_amount" value="{{ row.firefly_amount }}">
                                                                <div class="text-danger small" data-error-for="firefly_amount"></div>
                                                            </div>
                                                        </div>
                                                        <div class="row" style="margin-top: 10px;">
                                                            <div class="col-sm-4 form-group bill-autocomplete" data-autocomplete-type="account">
                                                                <label>来源账户</label>
                                                                <input class="form-control" type="text" autocomplete="off" name="source_name" data-field="source_name" value="{{ row.source_name }}">
                                                                <ul class="bill-autocomplete-menu"></ul>
                                                                <div class="text-danger small" data-error-for="source_name"></div>
                                                            </div>
                                                            <div class="col-sm-4 form-group bill-autocomplete" data-autocomplete-type="account">
                                                                <label>目标账户</label>
                                                                <input class="form-control" type="text" autocomplete="off" name="destination_name" data-field="destination_name" value="{{ row.destination_name }}">
                                                                <ul class="bill-autocomplete-menu"></ul>
                                                                <div class="text-danger small" data-error-for="destination_name"></div>
                                                            </div>
                                                            <div class="col-sm-4 form-group bill-autocomplete" data-autocomplete-type="category">
                                                                <label>Firefly 分类</label>
                                                                <input class="form-control" type="text" autocomplete="off" name="category_name" data-field="category_name" value="{{ row.category_name }}">
                                                                <ul class="bill-autocomplete-menu"></ul>
                                                                <div class="text-danger small" data-error-for="category_name"></div>
                                                            </div>
                                                        </div>
                                                        <div class="row" style="margin-top: 10px;">
                                                            <div class="col-sm-6 form-group">
                                                                <label>Firefly 描述</label>
                                                                <input class="form-control" name="firefly_description" data-field="firefly_description" value="{{ row.firefly_description }}">
                                                                <div class="text-danger small" data-error-for="firefly_description"></div>
                                                            </div>
                                                            <div class="col-sm-6 form-group">
                                                                <label>备注</label>
                                                                <input class="form-control" name="notes" data-field="notes" value="{{ row.notes }}">
                                                                <div class="text-danger small" data-error-for="notes"></div>
                                                            </div>
                                                        </div>
                                                        <div style="margin-top: 10px;">
                                                            <button type="submit" class="btn btn-success btn-sm">
                                                                <span class="fa fa-save fa-fw"></span> 保存
                                                            </button>
                                                            <span class="bill-row-save-feedback text-success" style="display: none; margin-left: 10px;"></span>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
            <div class="box">
                <div class="box-header with-border">
                    <h3 class="box-title">附件</h3>
                </div>
                <div class="box-body no-padding">
                    {% if task.artifacts.count() == 0 %}
                        <p class="text-muted" style="padding: 15px;">暂无附件。</p>
                    {% else %}
                        <table class="table table-striped">
                            <thead>
                            <tr>
                                <th>类型</th>
                                <th>文件</th>
                                <th style="width: 150px;">操作</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for artifact in task.artifacts %}
                                <tr>
                                    <td>{{ artifact.kind }}</td>
                                    <td>{{ artifact.display_name|default(artifact.filename|default(artifact.path|default('-'))) }}</td>
                                    <td>
                                        {% if artifact.can_preview %}
                                            <a class="btn btn-xs btn-default" href="{{ route('bill-inbox.artifact.preview', [artifact.id]) }}">
                                                <span class="fa fa-eye fa-fw"></span> 预览
                                            </a>
                                        {% endif %}
                                        <a class="btn btn-xs btn-default" href="{{ route('bill-inbox.artifact.download', [artifact.id]) }}">
                                            <span class="fa fa-download fa-fw"></span> 下载
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>

            <div class="box">
                <div class="box-header with-border">
                    <h3 class="box-title">邮件信息</h3>
                </div>
                <div class="box-body no-padding">
                    {% if task.mailMessage %}
                        <table class="table table-striped">
                            <tr><td style="width: 120px;">邮箱</td><td>{{ task.mailMessage.mailbox|default('-') }}</td></tr>
                            <tr><td>发件人</td><td>{{ task.mailMessage.from_address|default('-') }}</td></tr>
                            <tr><td>主题</td><td>{{ task.mailMessage.subject|default('-') }}</td></tr>
                            <tr><td>收到时间</td><td>{% if task.mailMessage.received_at %}{{ task.mailMessage.received_at.format('Y-m-d H:i') }}{% else %}-{% endif %}</td></tr>
                        </table>
                    {% else %}
                        <p class="text-muted" style="padding: 15px;">这个任务没有关联邮件记录。</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
            <div class="box">
                <div class="box-header with-border">
                    <h3 class="box-title">处理记录</h3>
                </div>
                <div class="box-body no-padding">
                    {% if task.events.count() == 0 %}
                        <p class="text-muted" style="padding: 15px;">暂无处理记录。</p>
                    {% else %}
                        <table class="table table-striped">
                            <thead>
                            <tr>
                                <th>时间</th>
                                <th>记录</th>
                                <th>说明</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for event in task.events %}
                                <tr>
                                    <td>{% if event.created_at %}{{ event.created_at.format('Y-m-d H:i') }}{% else %}-{% endif %}</td>
                                    <td>{{ eventLabels[event.event_type]|default(event.event_type) }}</td>
                                    <td>{{ event.message|default('-') }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script nonce="{{ JS_NONCE }}">
        window.billInboxConfig = {
            taskId: {{ task.id }},
            statusLabels: {{ statusLabels|json_encode|raw }},
            statusClasses: {{ statusClasses|json_encode|raw }},
            fireflyTypeLabels: {{ fireflyTypeLabels|json_encode|raw }}
        };
    </script>
    <script src="v1/js/ff/bill-inbox.js?v={{ FF_BUILD_TIME }}" nonce="{{ JS_NONCE }}"></script>
{% endblock %}
