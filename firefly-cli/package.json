{
  "name": "firefly-cli",
  "version": "1.0.0",
  "description": "Command-line client for Firefly III.",
  "type": "module",
  "bin": {
    "ffc": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "npm run typecheck && tsup",
    "build:watch": "tsup --watch",
    "test": "vitest",
    "test:run": "npm run typecheck && vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "firefly-iii",
    "cli",
    "personal-finance"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "pg": "^8.22.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.4",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
